# Add environment variables here
# VITE_API_URL=https://api.example.com
VITE_BANDHAN_PASSWORD=1234

# Server-side only — deliberately NOT prefixed VITE_, which would bake it into the
# client bundle and make it public. Set this in Vercel's project env vars.
OPENROUTER_API_KEY=sk-or-...
# Optional. Comma-separated, tried in order. Defaults to the free gpt-oss-20b
# endpoint with the same model's paid endpoint as fallback.
# OPENROUTER_MODELS=openai/gpt-oss-20b:free,openai/gpt-oss-20b
